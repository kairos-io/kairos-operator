{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchFileNames": ["examples/**", "config/samples/**", "config/crd/bases/**", "example.yaml"],
      "enabled": false
    },
    {
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/client-go",
        "k8s.io/apiextensions-apiserver",
        "k8s.io/apiserver",
        "k8s.io/component-base",
        "sigs.k8s.io/controller-runtime"
      ],
      "groupName": "kubernetes"
    }
  ]
}
